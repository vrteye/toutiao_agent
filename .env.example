# ═══════════════════════════════════════════════════════════════
#  环境变量配置说明
#  本项目不再使用 .env 文件，请通过系统环境变量设置以下配置：
# ═══════════════════════════════════════════════════════════════
#
# 【必填】DashScope API Key（在 https://bailian.console.aliyun.com/ 获取）
#   Windows:  setx DASHSCOPE_API_KEY "sk-xxxxxxxxxxxxxxxxxxxxxxxx"
#   Linux/Mac: export DASHSCOPE_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
#
# 【可选】代理设置（留空则不使用代理）
#   setx HTTP_PROXY "http://127.0.0.1:7890"
#   setx HTTPS_PROXY "http://127.0.0.1:7890"
#
# 【可选】Gradio 外网访问账号密码（服务器开放访问时建议设置）
#   Windows:  setx GRADIO_USERNAME "admin"
#   Windows:  setx GRADIO_PASSWORD "your-strong-password"
#   Linux/Mac: export GRADIO_USERNAME="admin"
#   Linux/Mac: export GRADIO_PASSWORD="your-strong-password"
#
# ═══════════════════════════════════════════════════════════════


可行：
set "DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx"
python main.py

export DASHSCOPE_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
